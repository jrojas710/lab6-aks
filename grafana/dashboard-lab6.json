{
  "uid": "lab6-portales",
  "title": "Lab 6 — WordPress y PrestaShop en AKS",
  "tags": [
    "lab6",
    "aks"
  ],
  "timezone": "America/Bogota",
  "refresh": "1m",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "schemaVersion": 39,
  "editable": true,
  "templating": {
    "list": [
      {
        "name": "ds",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 10,
      "type": "text",
      "title": "Qué muestra",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**Lab 6 — dos portales en un solo AKS.** Namespace `wordpress` (WordPress + MySQL) y `prestashop` (PrestaShop + MariaDB). Grafana solo observa el clúster: no usa las bases de datos de los portales. Tras un `rollout restart` aparecen pods con nombre nuevo."
      }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Pods Running por portal",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 3
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name",
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum by (namespace) (kube_pod_status_phase{phase=\"Running\",namespace=~\"wordpress|prestashop\"})",
          "legendFormat": "{{namespace}}",
          "instant": true
        }
      ]
    },
    {
      "id": 12,
      "type": "table",
      "title": "Pods de los dos portales",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 5,
        "w": 16,
        "x": 8,
        "y": 3
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "kube_pod_info{namespace=~\"wordpress|prestashop\"}",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "namespace": true,
              "pod": true,
              "node": true,
              "pod_ip": true,
              "created_by_name": true
            }
          }
        }
      ]
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU por pod (núcleos)",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum by (namespace,pod) (rate(container_cpu_usage_seconds_total{namespace=~\"wordpress|prestashop\",container!=\"\",container!=\"POD\"}[5m]))",
          "legendFormat": "{{namespace}} / {{pod}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Memoria por pod",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum by (namespace,pod) (container_memory_working_set_bytes{namespace=~\"wordpress|prestashop\",container!=\"\",container!=\"POD\"})",
          "legendFormat": "{{namespace}} / {{pod}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Reinicios de contenedores por pod",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum by (namespace,pod) (kube_pod_container_status_restarts_total{namespace=~\"wordpress|prestashop\"})",
          "legendFormat": "{{namespace}} / {{pod}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Tráfico de red recibido por pod",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum by (namespace,pod) (rate(container_network_receive_bytes_total{namespace=~\"wordpress|prestashop\"}[5m]))",
          "legendFormat": "{{namespace}} / {{pod}}"
        }
      ]
    }
  ]
}